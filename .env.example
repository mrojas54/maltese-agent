# Copy to .env (gitignored) and fill in. Names only here; never commit values.

# --- falcon-agent (Rust) ---
# "real" uses Gemini; anything else (or unset) uses the built-in fake poisoned LLM.
FALCON_LLM=
# Listen port; defaults to 3030 when unset or not a number.
PORT=

# --- Gemini (falcon-agent real mode, falcon-detective) ---
# Required for FALCON_LLM=real and for GEMINI_MODE=live or record.
GEMINI_API_KEY=
# falcon-detective: live | cassette | record. Defaults to live when unset.
# Tests set cassette; use record to re-record cassettes (npm run record).
GEMINI_MODE=

# --- falcon-mcp timeouts ---
# Optional per-limit overrides named FALCON_MCP_<NAME>_MS (milliseconds, must be > 0).
# See falcon-mcp/src/limits.rs for the <NAME> values.
